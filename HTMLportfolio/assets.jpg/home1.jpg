        </span><span class="ͼ13">&lt;marquee</span><span> </span><span class="ͼ12">bgcolor</span><span class="ͼv">=</span><span class="ͼz">"pink"</span><span class="ͼ13">&gt;</span><span>* Code * Learn * Create * Innovate *</span><span class="ͼ13">&lt;/marquee&gt;</span><span>

        </span><span class="ͼ13">&lt;p&gt;</span><span>
            </span><span class="ͼ13">&lt;a</span><span> </span><span class="ͼ12">href</span><span class="ͼv">=</span><span class="ͼz">"index.html"</span><span class="ͼ13">&gt;</span><span>Home</span><span class="ͼ13">&lt;/a&gt;</span><span> |
            </span><span class="ͼ13">&lt;a</span><span> </span><span class="ͼ12">href</span><span class="ͼv">=</span><span class="ͼz">"about.html"</span><span class="ͼ13">&gt;</span><span>About</span><span class="ͼ13">&lt;/a&gt;</span><span> |
