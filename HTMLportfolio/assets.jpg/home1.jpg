cket_catchup\",\"language_key\":\"hi\"},\"798559023047\":{\"campaign_key\":\"cricket_catchup\",\"language_key\":\"en\"},\"798559023035\":{\"campaign_key\":\"cricket_catchup\",\"language_key\":\"en\"},\"778169782547\":{\"campaign_key\":\"spicy_pani_puri\",\"language_key\":\"en\"},\"799747800160\":{\"campaign_key\":\"vanity_refresh\",\"language_key\":\"id\"},\"808801662897\":{\"language_key\":\"hi\",\"campaign_key\":\"sketch_to_brand\"},\"778150297184\":{\"campaign_key\":\"spicy_pani_puri\",\"language_key\":\"hi\"},\"1867626227240226\":{\"campaign_key\":\"football_bobblehead\",\"language_key\":\"pt\"},\"1867099689756913\":{\"language_key\":\"es\",\"campaign_key\":\"photo_to_headshot\"},\"807296684775\":{\"campaign_key\":\"image_canvas\",\"language_key\":\"id\"},\"798502712077\":{\"campaign_key\":\"spicy_pani_puri\",\"language_key\":\"en\"},\"120247183552630182\":{\"campaign_key\":\"football_bobblehead\",\"language_key\":\"en\"},\"798449148159\":{\"campaign_key\":\"cricket_catchup\",\"language_key\":\"hi_latn\"},\"1866356367603826\":{\"campaign_key\":\"data_visualization\",\"language_key\":\"ko\"},\"799705222719\":{\"campaign_key\":\"closet_room_refresh\",\"language_key\":\"en\"},\"120245715524760182\":{\"language_key\":\"hi_latn\",\"campaign_key\":\"hairstyle_analysis\"},\"1867097546221586\":{\"campaign_key\":\"photo_cartoon\",\"language_key\":\"es\"},\"120241043845760182\":{\"campaign_key\":\"mini_me_palm\",\"language_key\":\"en\"},\"808801371006\":{\"campaign_key\":\"photo_to_headshot\",\"language_key\":\"hi\"},\"807906984362\":{\"campaign_key\":\"image_canvas\",\"language_key\":\"hi_latn\"},\"793910549039\":{\"campaign_key\":\"restaurant_language_practice\",\"language_key\":\"ja\"},\"1868703841696898\":{\"campaign_key\":\"national_team_match_analysis\",\"language_key\":\"es\"},\"1867096733161522\":{\"campaign_key\":\"image_canvas\",\"language_key\":\"es\"},\"120241043845840182\":{\"language_key\":\"en\",\"campaign_key\":\"outfit_transfer\"},\"1868259085865169\":{\"campaign_key\":\"football_bobblehead\",\"language_key\":\"pt\"},\"778169782544\":{\"language_key\":\"en\",\"campaign_key\":\"spicy_pani_puri\"}},\"default_bootstrap_model_id\":\"gpt-5-5-instant\",\"language_instructions\":{\"es\":\"Response language for the first visible response: natural Spanish. Use Spanish for all visible text, including the lead-in and clickable suggestions. If the user later writes in another language, switch naturally.\",\"hi_latn\":\"Response language for the first visible response: natural Roman Hindi using Latin script only. Translate any English campaign wording before writing. Use Roman Hindi—not English—for every visible element, including the opening, lead-in, and all three clickable suggestions. Common borrowed words are fine, but never write a complete lead-in or suggestion in English. If the user later writes in another language or script, switch naturally.\",\"hi\":\"Response language for the first visible response: natural Hindi in Devanagari. Translate any English campaign wording before writing. Use Devanagari Hindi for every visible element—the opening, lead-in, and all three clickable suggestions—and do not copy full English phrases into the response. If the user later writes in another language or script, switch naturally.\",\"ja\":\"Response language for the first visible response: natural Japanese. Use Japanese for all visible text, including the lead-in and clickable suggestions. If the user later writes in another language, switch naturally.\",\"en\":\"Response language for the first visible response: natural English. Use English for all visible text, including the lead-in and clickable suggestions. If the user later writes in another language, switch naturally.\",\"pt\":\"Response language for the first visible response: natural Brazilian Portuguese. Use Brazilian Portuguese for all visible text, including the lead-in and clickable suggestions. If the user later writes in another language, switch naturally.\",\"id\":\"Response language for the first visible response: natural Indonesian. Use Indonesian for all visible text, including the lead-in and clickable suggestions. Use standard Indonesian punctuation: keep the two opening sentences in one paragraph and end each with a period; an optional emoji may follow the first period. If the user later writes in another language, switch naturally.\",\"ko\":\"Response language for the first visible response: natural Korean. Use Korean for all visible text, including the lead-in and clickable suggestions. If the user later writes in another language, switch naturally.\"},\"enabled\":true},\"is_device_based\":true,\"passed\":false},\"2055363467\":{\"name\":\"2055363467\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"should_send\":true,\"max_receivers_per_rule\":5,\"can_configure\":true,\"max_notification_rules_per_scan\":10},\"is_device_based\":false,\"passed\":false},\"2133596510\":{\"name\":\"2133596510\",\"rule_id\":\"USeZCOloSU02kTe6xjZuA\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"enabled\":true},\"is_device_based\":false,\"group_name\":\"Test\",\"is_experiment_active\":true,\"is_user_in_experiment\":true},\"1939873467\":{\"name\":\"1939873467\",\"rule_id\":\"launchedGroup\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"enabled\":true},\"is_device_based\":false,\"group_name\":\"Live-only update\",\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"301381018\":{\"name\":\"301381018\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"passed\":false},\"1598825633\":{\"name\":\"1598825633\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"enabled\":true,\"denominator\":0},\"is_device_based\":false,\"passed\":false},\"1001765573\":{\"name\":\"1001765573\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"4113286138\",\"gateValue\":\"false\